# Copy to .env.local for local development and add the same values in
# Vercel -> Project -> Settings -> Environment Variables. Never commit .env.local.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://code-motive.dev
# WhatsApp number with country code, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=923265152747
# Leave a profile empty to hide it everywhere.
LINKEDIN_URL=https://www.linkedin.com/company/code-motive
INSTAGRAM_URL=https://www.instagram.com/codemotive.dev/
UPWORK_URL=
# Optional street address; "Lahore, Pakistan" is shown when empty.
BUSINESS_ADDRESS=

# --- Analytics ------------------------------------------------------------------
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty = GA and the cookie
# banner are off; Vercel Analytics (cookieless) always runs on Vercel.
NEXT_PUBLIC_GA_ID=

# --- Admin (/admin/login) -------------------------------------------------
# Password for the admin. Use a long, unique one.
ADMIN_PASSWORD=
# Optional: separate key for signing admin sessions. If empty, sessions are
# signed with ADMIN_PASSWORD (changing the password signs everyone out).
ADMIN_SESSION_SECRET=

# --- Database (MongoDB Atlas) ---------------------------------------------
# Stores prices, projects and uploaded project screenshots. Without it the
# site shows the defaults from data/ and the admin can't save.
# Atlas -> Database -> Connect -> Drivers. Allow access from Vercel
# (Network Access -> 0.0.0.0/0, or Vercel's integration).
MONGODB_URI=
MONGODB_DB=codemotive

# --- Instant AI reply (contact + free mockup forms) ------------------------
# Groq first, Gemini as fallback, a fixed template if both are missing/failing.
# Keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Email (Resend) ---------------------------------------------------------
# Verify code-motive.dev in Resend first (SPF + DKIM DNS records).
RESEND_API_KEY=
# Lead notifications to you:
RESEND_FROM="CodeMotive Website <admin@code-motive.dev>"
# Confirmation copy to the visitor:
RESEND_VISITOR_FROM="Bilal at CodeMotive <admin@code-motive.dev>"
CONTACT_TO_EMAIL=admin@code-motive.dev

# --- Spam protection (Cloudflare Turnstile, free) ----------------------------
# Rate limiting (3 per IP per 10 min) uses MongoDB; no extra service needed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Task manager -------------------------------------------------------------
# "jira" creates an issue per lead; anything else turns tasks off.
TASK_PROVIDER=jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=LEAD
JIRA_ISSUE_TYPE=Task

# --- Daily follow-up digest (Vercel Cron, see vercel.json) -------------------
# Long random string. Vercel sends it with each cron call; without it the
# digest is off. Needs RESEND_API_KEY.
CRON_SECRET=
